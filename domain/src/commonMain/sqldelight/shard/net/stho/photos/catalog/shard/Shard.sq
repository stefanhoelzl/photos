import kotlin.Int;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;
import net.stho.photos.catalog.ObjectId;
import net.stho.photos.catalog.AlbumState;
import net.stho.photos.model.MediaType;

-- The shard schema, DESIGN §3, one album per file at `meta/<album-uuid>.db`.
--
-- `album_id` and `source_path` are permanently stable: never removed, never retyped, whatever
-- a later schema_version does. That is what lets any reader learn which folder a shard claims
-- without understanding the rest of it, so a shard too new to read is still *identifiable*
-- rather than merely unreadable -- which is what stops its directory being re-uploaded as a
-- duplicate album (§3).
--
-- `IF NOT EXISTS` throughout because these statements also run against files that already have
-- the tables: a shard fetched from the zone is opened as a file, not created.
CREATE TABLE IF NOT EXISTS album_info (
  id             INTEGER PRIMARY KEY CHECK (id = 1),
  album_id       TEXT AS Uuid NOT NULL,
  name           TEXT NOT NULL,
  parent         TEXT AS Uuid,
  source_path    TEXT,
  cover_photo_id TEXT AS Uuid,
  thumbs_id      TEXT AS ObjectId,
  -- Where this album is in its lifecycle (§7). Text rather than a number because nothing
  -- computes with it -- every rule is an equality test -- so it may as well read as itself in
  -- a shell, which is the same reason the rest of these are real typed columns.
  state            TEXT AS AlbumState NOT NULL,
  -- Which encoding profile produced this album's image blobs. 0 means "as uploaded, never
  -- encoded here"; profiles number from 1 (DerivativeSpec.ENCODING_VERSION).
  encoding_version INTEGER AS Int NOT NULL,
  added_at       INTEGER AS Instant NOT NULL,
  schema_version INTEGER AS Int NOT NULL,
  -- The album this shard adds photos to, or NULL for an album of its own. An addition lives at
  -- `addition/<uuid>.db` rather than under `meta/`, and its `name` and `parent` hold the target's
  -- as they were when it was uploaded -- so a target deleted before the laptop merges it leaves an
  -- addition that reads as an album of its own, with nothing lost (§8). Schema 5.
  adds_to        TEXT AS Uuid,
  CHECK (state IN ('uploading', 'uploaded', 'encoded')),
  -- The two columns cannot disagree about whether the laptop has encoded this album: an
  -- 'encoded' album at version 0, or an 'uploaded' one at version 1, are both unwritable.
  CHECK ((state = 'encoded') = (encoding_version > 0))
);

CREATE TABLE IF NOT EXISTS photo (
  id              TEXT AS Uuid PRIMARY KEY,
  filename        TEXT NOT NULL,
  source_filename TEXT,
  taken_at        INTEGER AS Instant,
  lat             REAL,
  lon             REAL,
  width           INTEGER AS Int,
  height          INTEGER AS Int,
  bytes           INTEGER,
  -- The size of the file on disk, as distinct from `bytes` above, which is the blob. This is
  -- what the change assertion compares against the directory entry -- free, since the scan
  -- reads it anyway, and unlike the old check it covers every row rather than only those
  -- whose blob happened to be the file (§7).
  source_bytes    INTEGER,
  -- SHA-256 of the file on disk, recorded at ingest and never verified on a schedule: a full
  -- pass is ~100 GiB of reads. Named for which content it means -- since §2 the blob key is
  -- itself a content hash, and the two answer different questions. This one covers the
  -- *original*, the copy nothing can reconstruct; the key covers a derivative the laptop can
  -- always rebuild (§7).
  original_hash   TEXT,
  media_type      INTEGER AS MediaType NOT NULL,
  -- The one image a reader displays. While an album is 'uploading' or 'uploaded' this is the
  -- phone's full-quality upload; once 'encoded' it is the 3200px HEIC. The meaning does not
  -- change with state, so a reader that knows nothing about `state` still renders correctly
  -- -- it merely fetches something heavier (§3).
  image_id        TEXT AS ObjectId,
  -- The source still of a Live Photo, kept byte-for-byte and only for pairs. `PHLivePhotoView`
  -- matches a still to its MOV by Apple's `content.identifier`, which re-encoding strips -- so
  -- the one case that needs an untouched original still gets one. 187 pairs library-wide (§5).
  live_still_id   TEXT AS ObjectId,
  live_video_id   TEXT AS ObjectId,
  video_id        TEXT AS ObjectId,
  -- The paired MOV's name on disk, for a Live Photo. The MOV is a file with no row of its own
  -- -- §3 keeps the pair as one row with two blobs -- so this is the only place the catalog
  -- can say that the file is already accounted for. Without it reconciliation sees an
  -- unclaimed file and plans all 187 of them as uploads on every run (§7). Schema 4.
  live_video_filename TEXT
);

CREATE INDEX IF NOT EXISTS ix_photo_taken ON photo(taken_at);

insertAlbumInfo:
INSERT INTO album_info (
  id, album_id, name, parent, source_path, cover_photo_id, thumbs_id,
  state, encoding_version, added_at, schema_version, adds_to
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Columns are named rather than starred: `schema_version` promises a reader keeps working when
-- a *newer* writer adds a column, and `SELECT *` would break that promise by shifting indices.
selectAlbumInfo:
SELECT album_id, name, parent, source_path, cover_photo_id, thumbs_id,
       state, encoding_version, added_at, schema_version, adds_to
FROM album_info WHERE id = 1;

-- A shard written before schema 5 has no `adds_to`, for the same reason as the two photo selects
-- below: SQLite fails a statement naming a column the file does not have.
selectAlbumInfoBeforeSchema5:
SELECT album_id, name, parent, source_path, cover_photo_id, thumbs_id,
       state, encoding_version, added_at, schema_version
FROM album_info WHERE id = 1;

-- What a shard says about itself even when it is too new to read: only §3's two permanently
-- stable columns, so this keeps working across every future schema.
selectProbe:
SELECT album_id, source_path, schema_version FROM album_info WHERE id = 1;

-- The version alone, so a caller can decide to skip a shard before paying to read it.
selectSchemaVersion:
SELECT schema_version FROM album_info WHERE id = 1;

insertPhoto:
INSERT INTO photo (
  id, filename, source_filename, taken_at, lat, lon, width, height, bytes,
  source_bytes, original_hash, media_type, image_id, live_still_id, live_video_id, video_id,
  live_video_filename
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Two selects, one per era, because §3's promise that a reader reads any shard at or below its
-- own version has a price here: a shard written before schema 4 has no `live_video_filename`
-- column at all, and SQLite fails the whole statement rather than returning nulls for it. The
-- reader picks by `schema_version`, which it has already read.
selectPhotos:
SELECT id, filename, source_filename, taken_at, lat, lon, width, height, bytes,
       source_bytes, original_hash, media_type, image_id, live_still_id, live_video_id, video_id,
       live_video_filename
FROM photo;

selectPhotosBeforeSchema4:
SELECT id, filename, source_filename, taken_at, lat, lon, width, height, bytes,
       source_bytes, original_hash, media_type, image_id, live_still_id, live_video_id, video_id
FROM photo;
