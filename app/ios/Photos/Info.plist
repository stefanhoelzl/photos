<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- ProMotion. Without it iOS caps a non-declaring app at 60 fps, and Compose refuses to
	     start rather than let that happen quietly. It matters more here than in most apps:
	     §10's one remaining unknown is whether the grid holds its frame rate at the 2-column
	     pinch density, and measuring that against a 60 fps ceiling would answer a different
	     question from the one asked. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- HTTPS to the storage zone and the platform's own crypto for SigV4 and the Keychain,
	     and nothing proprietary: that is precisely what this exemption covers. Declared here so
	     an upload goes straight to internal testers rather than stalling in Missing Compliance,
	     which would defeat uploading on every merge. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Every orientation the app may ever take. §6's layout is a phone column -- a large title,
	     a list, and a grid whose density is pinched rather than rotated -- so the app delegate
	     narrows this to portrait at run time, and widens it only while a photo is open. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
